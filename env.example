# Local AI (Ollama / LM Studio — OpenAI 호환 API)
# Ollama 기본값: http://localhost:11434/v1
# Android 에뮬레이터 기본값: http://10.0.2.2:11434/v1 (코드에서 Platform별 자동 설정)
# 실기기: 같은 Wi-Fi의 PC IP 사용 예) http://192.168.0.10:11434/v1
# LM Studio 예: http://localhost:1234/v1
EXPO_PUBLIC_LOCAL_AI_BASE_URL=http://localhost:11434/v1
EXPO_PUBLIC_LOCAL_AI_MODEL=llama3.2
# Ollama/LM Studio는 키가 없어도 되지만, SDK 호환을 위해 임의의 값 사용
EXPO_PUBLIC_LOCAL_AI_API_KEY=local-ai

# Google AdMob Unit ID (예: ca-app-pub-xxxxx/xxxxx)
EXPO_PUBLIC_ADMOB_UNIT_ID=your_admob_unit_id_here
