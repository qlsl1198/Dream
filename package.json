{
  "name": "dreaminterpreterapp",
  "version": "1.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test": "node scripts/check-ios-lifecycle.cjs && node scripts/test.cjs",
    "verify": "npm run typecheck && npm test && npm run doctor",
    "build:ios": "npx --yes eas-cli@25.3.0 build --platform ios --profile production",
    "build:android": "npx --yes eas-cli@25.3.0 build --platform android --profile production",
    "submit:ios": "npx --yes eas-cli@25.3.0 submit --platform ios --profile production --latest",
    "submit:android": "npx --yes eas-cli@25.3.0 submit --platform android --profile production --latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-device": "^7.1.4",
    "expo-file-system": "^18.1.11",
    "expo-font": "~13.3.2",
    "expo-linear-gradient": "~14.1.5",
    "expo-notifications": "~0.31.5",
    "expo-sharing": "^13.1.5",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "expo-document-picker": "~13.1.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "expo-doctor": "^1.20.1",
    "typescript": "~5.8.3"
  },
  "expo": {
    "autolinking": {
      "searchPaths": ["./node_modules", "./node_modules/expo/node_modules"]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "engines": { "node": ">=20.19.4" },
  "private": true
}
